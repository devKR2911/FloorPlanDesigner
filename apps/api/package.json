{
  "name": "@floorplandesigner/api",
  "version": "0.0.0",
  "private": true,
  "description": "Hono backend that stores plans in Postgres.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@floorplandesigner/engine": "workspace:*",
    "@floorplandesigner/shared": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "drizzle-orm": "^0.45.4",
    "hono": "catalog:",
    "pg": "^8.23.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
