# Copy this file to .env. These values match docker-compose.yml and are for local development only.
POSTGRES_USER=floorplan
POSTGRES_PASSWORD=floorplan
POSTGRES_DB=floorplandesigner
POSTGRES_PORT=5434

DATABASE_URL=postgres://floorplan:floorplan@localhost:5434/floorplandesigner

# Port for the backend. The web dev server proxies /api to it.
PORT=3000
