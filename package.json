{
  "name": "floorplandesigner",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "dev": "pnpm build:packages && concurrently -k -n engine,shared,api,web -c blue,magenta,green,cyan \"pnpm --filter @floorplandesigner/engine dev\" \"pnpm --filter @floorplandesigner/shared dev\" \"pnpm --filter @floorplandesigner/api dev\" \"pnpm --filter @floorplandesigner/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm build:packages && pnpm -r test",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.2"
  }
}
